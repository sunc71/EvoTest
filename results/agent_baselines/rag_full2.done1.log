"""Comprehensive test suite for _pytest.nodes module."""


def test_splitnode_empty():
    """Test _splitnode with empty string."""
    from _pytest.nodes import _splitnode
    
    result = _splitnode("")
    assert result == ()


def test_splitnode_simple_path():
    """Test _splitnode with simple path."""
    from _pytest.nodes import _splitnode
    
    result = _splitnode("testing/code")
    assert result == ("testing", "code")


def test_splitnode_with_file():
    """Test _splitnode with file path."""
    from _pytest.nodes import _splitnode
    
    result = _splitnode("testing/code/test_excinfo.py")
    assert result == ("testing", "code", "test_excinfo.py")


def test_splitnode_with_class():
    """Test _splitnode with class name."""
    from _pytest.nodes import _splitnode
    
    result = _splitnode("testing/code/test_excinfo.py::TestFormattedExcinfo")
    assert result == ("testing", "code", "test_excinfo.py", "TestFormattedExcinfo")


def test_splitnode_with_function():
    """Test _splitnode with function name."""
    from _pytest.nodes import _splitnode
    
    result = _splitnode("testing/test_nodes.py::test_splitnode")
    assert result == ("testing", "test_nodes.py", "test_splitnode")


def test_ischildnode_true_cases():
    """Test ischildnode returns True for valid child relationships."""
    from _pytest.nodes import ischildnode
    
    # 'foo/bar::Baz' is child of 'foo'
    assert ischildnode("foo", "foo/bar::Baz") is True
    
    # 'foo/bar::Baz' is child of 'foo/bar'
    assert ischildnode("foo/bar", "foo/bar::Baz") is True
    
    # 'foo/bar::Baz' is child of 'foo/bar::Baz'
    assert ischildnode("foo/bar::Baz", "foo/bar::Baz") is True


def test_ischildnode_false_cases():
    """Test ischildnode returns False for invalid child relationships."""
    from _pytest.nodes import ischildnode
    
    # 'foo/blorp' is not parent of 'foo/bar::Baz'
    assert ischildnode("foo/blorp", "foo/bar::Baz") is False
    
    # 'foo/bar/baz' is not parent of 'foo/bar'
    assert ischildnode("foo/bar/baz", "foo/bar") is False


def test_node_meta_warning():
    """Test NodeMeta issues warning when directly instantiated."""
    import warnings
    from _pytest.nodes import Node
    
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        try:
            # This should trigger a deprecation warning
            node = Node(name="test")
        except TypeError:
