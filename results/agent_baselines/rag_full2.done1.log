def test_ischildnode_edge_cases():
    """Test ischildnode with edge cases."""
    from _pytest.nodes import ischildnode
    
    # Empty baseid
    assert ischildnode("", "foo/bar") is True
    
    # Same nodeid
    assert ischildnode("same", "same") is True
    
    # Completely different paths
    assert ischildnode("a/b/c", "x/y/z") is False
